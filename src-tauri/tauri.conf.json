{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "recorder_mic",
  "version": "0.1.1",
  "identifier": "com.endingve.recorder-mic",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "recorder_mic — direct MP3",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
